# macOS
.DS_Store

# Резервные копии, которые делаются перед крупными переделками
*.bak

# Настройки Claude Code — машинные, не общие.
# Мозг может оказаться сразу на двух машинах: контейнер бота на сервере и
# Claude Code на компьютере. Движок читает настройки проекта на ОБЕИХ, поэтому
# settings.json, уехавший с одной машины, молча исполняется на другой — с путями,
# которых там нет. Машинное — только в settings.local.json, он не коммитится.
.claude/settings.json
.claude/settings.local.json
